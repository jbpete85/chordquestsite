---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const base = import.meta.env.BASE_URL;

const faqItems = [
  {
    question: 'What is Chord Quest?',
    answer: 'Chord Quest is an interactive music learning app that turns physical sheet music into playable audio. Snap a photo or upload a score to hear your part, control tempo, and practice with confidence.',
  },
  {
    question: 'Does it work with any sheet music?',
    answer: 'Chord Quest reads photos, PDFs, and images of sheet music, and is optimized for clean, clear beginner-level scores across piano, voice, strings, and more. It does not support handwritten notation.',
  },
  {
    question: 'Can I isolate just my part?',
    answer: 'Yes. You can mute and hear staves independently. True individual part isolation is on our development roadmap.',
  },
  {
    question: 'Is this meant to replace lessons?',
    answer: 'No. Chord Quest supports teachers by reinforcing productive practice between lessons, helping students practice more independently.',
  },
];
---
<BaseLayout>
  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <h1 class="headline-xl hero__headline">Any Sheet Music.<br/>Any Instrument.<br/>Hear And Play Back.<br/><span class="hero__gold">Instantly</span></h1>
        <p class="body-lg hero__sub">Upload or snap a pic of any piece of sheet music. Chord Quest reads the notes and plays back your exact part in seconds&nbsp;&mdash; no library to search, no instrument limitations, no guessing how it goes.</p>
        <div class="hero__ctas">
          <a href="https://app.chordquestmusic.com" class="btn btn--gold">Get Started Free</a>
          <button class="btn btn--outline" id="watch-it-work-btn">Watch It Work &rarr;</button>
        </div>
      </div>
      <div class="hero__mockup">
        <div class="hero__shape hero__shape--1"></div>
        <div class="hero__shape hero__shape--2"></div>
        <img src={`${base}images/phone-shadow-2x.png`} alt="Chord Quest app on iPhone showing sheet music playback" class="hero__device" />
      </div>
    </div>
  </section>

  <!-- ===== VIDEO MODAL ===== -->
  <div class="video-modal" id="video-modal" hidden>
    <div class="video-modal__backdrop" id="video-modal-backdrop"></div>
    <div class="video-modal__content">
      <button class="video-modal__close" id="video-modal-close" aria-label="Close video">&times;</button>
      <video class="video-modal__player" id="video-modal-player" controls preload="metadata">
        <source src={`${base}images/sizzle-reel.mp4`} type="video/mp4" />
      </video>
    </div>
  </div>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="how-it-works section" id="how-it-works">
    <div class="container">
      <div class="how-it-works__header">
        <p class="eyebrow">How It Works</p>
        <h2 class="headline-lg">Capture The Music.<br/>Master Your Part.</h2>
        <p class="body-lg text-warm how-it-works__sub">No more searching libraries, hoping to find the song and instrument you need. Chord Quest reads directly from your sheet music. Any publisher, any edition.</p>
      </div>

      <div class="steps-interactive">
        <!-- Step 1 -->
        <div class="step-row reveal">
          <div class="step-tile">
            <div class="step-tile__text">
              <div class="step-tile__heading">
                <span class="step-tile__num">1</span>
                <h3 class="step-tile__title">Point Your Camera</h3>
              </div>
              <p class="step-tile__body">Scan or upload any piece of music you're working on.</p>
            </div>
            <div class="step-tile__visual">
              <img src={`${base}images/justiphone.png`} alt="iPhone camera scanning sheet music" class="step-tile__photo" />
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="step-row step-row--reverse reveal">
          <div class="step-tile">
            <div class="step-tile__text">
              <div class="step-tile__heading">
                <span class="step-tile__num">2</span>
                <h3 class="step-tile__title">It Reads Every Note</h3>
              </div>
              <p class="step-tile__body">Chord Quest reads every note–directly from the music.</p>
            </div>
            <div class="step-tile__visual">
              <div class="device-macbook">
                <video class="device-macbook__screen" muted playsinline preload="metadata" data-play-once>
                  <source src={`${base}images/processing-success-clip.mp4`} type="video/mp4" />
                </video>
                <img src={`${base}images/macbook-bezel.png`} alt="" class="device-macbook__bezel" aria-hidden="true" />
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="step-row reveal">
          <div class="step-tile">
            <div class="step-tile__text">
              <div class="step-tile__heading">
                <span class="step-tile__num">3</span>
                <h3 class="step-tile__title">Hear the Exact Part</h3>
              </div>
              <p class="step-tile__body">Hear your notes isolated or as part of the full ensemble.</p>
            </div>
            <div class="step-tile__visual">
              <div class="device-ipad">
                <video class="device-ipad__screen" muted playsinline preload="metadata" data-play-once>
                  <source src={`${base}images/playthrough-clip.mp4`} type="video/mp4" />
                </video>
                <img src={`${base}images/ipad-bezel.png`} alt="" class="device-ipad__bezel" aria-hidden="true" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Reveal on scroll
    const revealEls = document.querySelectorAll('.reveal');
    if (revealEls.length > 0) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      revealEls.forEach((el) => revealObserver.observe(el));
    }

    // Play videos once on reveal
    const playOnceVideos = document.querySelectorAll('video[data-play-once]');
    if (playOnceVideos.length > 0) {
      const videoObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const video = entry.target;
              video.play().catch(() => {});
              videoObserver.unobserve(video);
            }
          });
        },
        { threshold: 0.3 }
      );
      playOnceVideos.forEach((video) => videoObserver.observe(video));
    }

    // Video modal
    const watchBtn = document.getElementById('watch-it-work-btn');
    const modal = document.getElementById('video-modal');
    const backdrop = document.getElementById('video-modal-backdrop');
    const closeBtn = document.getElementById('video-modal-close');
    const player = document.getElementById('video-modal-player') as HTMLVideoElement;

    function openModal() {
      modal?.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      player?.play().catch(() => {});
    }
    function closeModal() {
      modal?.setAttribute('hidden', '');
      document.body.style.overflow = '';
      player?.pause();
      if (player) player.currentTime = 0;
    }

    watchBtn?.addEventListener('click', openModal);
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.hasAttribute('hidden')) closeModal();
    });
  </script>

  <!-- ===== FOR TEACHERS STRIP ===== -->
  <section class="teachers-strip section">
    <div class="container">
      <div class="teachers-strip__content">
        <p class="eyebrow">For Teachers</p>
        <h2 class="headline-lg teachers-strip__headline">The between-lesson practice tool music students love.</h2>
        <p class="body-lg teachers-strip__body">Give every student in your class instant playback of their exact part using the sheet music they already own. They come prepared, letting you teach the perfect lesson!</p>
        <a href={`${base}teachers#contact`} class="btn btn--gold">Teachers Download Free</a>
      </div>
      <div class="teachers-strip__mockup">
        <img src={`${base}images/Product%20Shot.png`} alt="Chord Quest app product screenshot" class="teachers-strip__product-shot" />
      </div>

      <!-- Testimonial bubbles -->
      <div class="teachers-strip__testimonials">
        <div class="testimonial-blob testimonial-blob--1">
          <svg class="testimonial-blob__shape" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,79.6,-45.8C87.4,-32.5,90,-16.3,88.5,-0.9C87,14.5,81.4,29,72.4,41.1C63.4,53.2,51,62.9,37.4,70.3C23.8,77.7,8.9,82.8,-5.2,82.1C-19.3,81.3,-32.6,74.8,-44.8,66.5C-57,58.2,-68.1,48.2,-75.1,35.4C-82.1,22.6,-85,7.1,-83.2,-7.5C-81.4,-22.1,-74.9,-35.8,-65.1,-46.5C-55.3,-57.2,-42.2,-64.9,-28.8,-72.4C-15.4,-79.9,-1.7,-87.2,11.4,-86.4C24.5,-85.6,30.6,-83.6,44.7,-76.4Z" transform="translate(100 100)" />
          </svg>
          <div class="testimonial-blob__bubble">
            <p class="testimonial-blob__quote">&ldquo;My students can hear what it's supposed to sound like even when I'm not there. Home practice is so much more beneficial.&rdquo;</p>
            <p class="testimonial-blob__author"><strong>David</strong> &mdash; Music Teacher</p>
          </div>
        </div>

        <div class="testimonial-blob testimonial-blob--2">
          <svg class="testimonial-blob__shape" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M39.5,-67.4C51.8,-60.7,63,-51.2,71.5,-39C80,-26.8,85.8,-11.8,84.2,2.2C82.6,16.2,73.6,29.2,63.2,40.3C52.8,51.4,41,60.5,27.7,67.1C14.4,73.7,-0.4,77.8,-15.5,76.8C-30.6,75.8,-46,69.7,-56.3,58.8C-66.6,47.9,-71.8,32.2,-75.4,16C-79,-0.2,-81,-17,-76,-31C-71,-45,-59,-56.2,-45.5,-62.4C-32,-68.6,-17,-69.8,-1.6,-67.1C13.8,-64.4,27.2,-74.1,39.5,-67.4Z" transform="translate(100 100)" />
          </svg>
          <div class="testimonial-blob__bubble">
            <p class="testimonial-blob__quote">&ldquo;I've always wished I had an orchestra in my home to practice with. Chord Quest has now provided that for me.&rdquo;</p>
            <p class="testimonial-blob__author"><strong>Mei</strong> &mdash; Professional Piano Player</p>
          </div>
        </div>

        <div class="testimonial-blob testimonial-blob--3">
          <svg class="testimonial-blob__shape" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M47.7,-79.1C62.3,-72.3,75,-60.3,82.6,-45.6C90.2,-30.9,92.7,-13.5,90.4,2.6C88.1,18.7,81,33.4,71.1,45.3C61.2,57.2,48.5,66.3,34.7,72.1C20.9,77.9,6,80.4,-8.6,78.6C-23.2,76.8,-37.5,70.7,-49.5,62C-61.5,53.3,-71.2,42,-77.2,28.5C-83.2,15,-85.5,-0.7,-82.3,-15C-79.1,-29.3,-70.4,-42.2,-58.8,-49.8C-47.2,-57.4,-32.7,-59.7,-19.4,-67.4C-6.1,-75.1,6,-88.2,19.6,-89.3C33.2,-90.4,48.3,-79.5,47.7,-79.1Z" transform="translate(100 100)" />
          </svg>
          <div class="testimonial-blob__bubble">
            <p class="testimonial-blob__quote">&ldquo;Playing with other musicians is so much more enjoyable now! Chord Quest lets us share music easily and practice our parts together.&rdquo;</p>
            <p class="testimonial-blob__author"><strong>Sarah</strong> &mdash; Choir Director</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FOR PARENTS STRIP ===== -->
  <section class="parents-strip section">
    <div class="container parents-strip__inner">
      <div class="parents-strip__decor">
        <div class="parents-strip__graphic">
          <svg viewBox="0 0 200 280" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <line x1="20" y1="60" x2="180" y2="60" stroke="#D9B077" stroke-opacity="0.15" stroke-width="1"/>
            <line x1="20" y1="75" x2="180" y2="75" stroke="#D9B077" stroke-opacity="0.15" stroke-width="1"/>
            <line x1="20" y1="90" x2="180" y2="90" stroke="#D9B077" stroke-opacity="0.15" stroke-width="1"/>
            <line x1="20" y1="105" x2="180" y2="105" stroke="#D9B077" stroke-opacity="0.15" stroke-width="1"/>
            <line x1="20" y1="120" x2="180" y2="120" stroke="#D9B077" stroke-opacity="0.15" stroke-width="1"/>
            <circle cx="70" cy="82" r="6" fill="#D9B077" fill-opacity="0.12"/>
            <circle cx="110" cy="97" r="6" fill="#D9B077" fill-opacity="0.12"/>
            <circle cx="140" cy="67" r="6" fill="#D9B077" fill-opacity="0.12"/>
            <line x1="20" y1="170" x2="180" y2="170" stroke="#D9B077" stroke-opacity="0.1" stroke-width="1"/>
            <line x1="20" y1="185" x2="180" y2="185" stroke="#D9B077" stroke-opacity="0.1" stroke-width="1"/>
            <line x1="20" y1="200" x2="180" y2="200" stroke="#D9B077" stroke-opacity="0.1" stroke-width="1"/>
            <line x1="20" y1="215" x2="180" y2="215" stroke="#D9B077" stroke-opacity="0.1" stroke-width="1"/>
            <line x1="20" y1="230" x2="180" y2="230" stroke="#D9B077" stroke-opacity="0.1" stroke-width="1"/>
          </svg>
        </div>
      </div>
      <div class="parents-strip__content">
        <p class="eyebrow">For Parents</p>
        <h2 class="headline-lg">No Music Background?<br/><span class="text-gold">No Problem.</span></h2>
        <p class="body-lg text-warm">When students know what their part should sound like, learning music becomes more productive, and far less frustrating. With Chord Quest's sheet music playback technology, parents can confidently support their child's practice without preparation or needing to know how to read a single note.</p>
        <a href={`${base}parents`} class="btn btn--gold">Learn More</a>
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section class="pricing section" id="pricing">
    <div class="container">
      <div class="pricing__header">
        <p class="eyebrow">Pricing</p>
        <h2 class="headline-lg pricing__headline">Start free. Stay affordable.</h2>
        <p class="body-lg text-warm pricing__sub">Every plan starts with a free 7-day trial.</p>
        <p class="pricing__teacher-note"><strong>Chord Quest is Free Forever for Teachers</strong></p>
      </div>
      <div class="pricing__grid">
        <div class="pricing__card">
          <div class="pricing__card-header">
            <h3 class="pricing__plan-name">Individual</h3>
            <p class="pricing__price"><span class="pricing__amount">$4.99</span><span class="pricing__period">/month</span></p>
          </div>
          <ul class="pricing__features">
            <li>Perfect for solo musicians</li>
            <li>Unlimited sheet music</li>
            <li>Practice tracking</li>
            <li>Cloud storage</li>
            <li>All instruments</li>
          </ul>
          <a href="https://app.chordquestmusic.com" class="btn btn--gold pricing__cta">Start Free Trial</a>
        </div>
        <div class="pricing__card pricing__card--featured">
          <div class="pricing__badge">Popular</div>
          <div class="pricing__card-header">
            <h3 class="pricing__plan-name">Family</h3>
            <p class="pricing__price"><span class="pricing__amount">$8.00</span><span class="pricing__period">/month</span></p>
          </div>
          <ul class="pricing__features">
            <li>Everything in Individual</li>
            <li>Share with up to 10 family members</li>
            <li>Account management features</li>
            <li>Individual progress tracking</li>
          </ul>
          <a href="https://app.chordquestmusic.com" class="btn btn--gold pricing__cta">Start Free Trial</a>
        </div>
      </div>
      <p class="pricing__trial-note">7-day free trial on all plans. Cancel anytime.</p>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="faq section--sm" id="faq">
    <div class="container container--narrow">
      <h2 class="headline-md faq__headline">Frequently Asked Questions</h2>
      <FaqAccordion items={faqItems} />
    </div>
  </section>

  <!-- ===== FINAL CTA ===== -->
  <section class="final-cta section">
    <div class="final-cta__lines" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="container container--narrow final-cta__inner">
      <h2 class="headline-lg final-cta__headline">The difference between a student who practiced and one who didn't is obvious the second they sit down.</h2>
      <p class="body-lg final-cta__sub">Every student deserves to walk in prepared. Every teacher deserves to teach the good stuff.</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== HERO ===== */
  .hero {
    background-color: var(--color-dark);
    padding: 80px 0 96px;
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .hero__headline {
    color: var(--color-cream);
    margin-bottom: 24px;
  }
  .hero__gold {
    color: var(--color-gold);
  }
  .hero__sub {
    color: var(--color-text-muted);
    margin-bottom: 36px;
    max-width: 520px;
  }
  .hero__ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero__mockup {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .hero__shape {
    position: absolute;
    z-index: 0;
  }
  .hero__shape--1 {
    width: 440px;
    height: 480px;
    background-color: var(--color-gold);
    border-radius: 62% 38% 46% 54% / 60% 44% 56% 40%;
    top: 50%;
    left: 50%;
    margin-top: -260px;
    margin-left: -180px;
    animation: float-1 8s ease-in-out infinite;
  }
  .hero__shape--2 {
    width: 480px;
    height: 520px;
    background-color: var(--color-gold-light);
    opacity: 0.35;
    border-radius: 80% 20% 60% 40% / 30% 70% 20% 80%;
    top: 50%;
    left: 50%;
    margin-top: -250px;
    margin-left: -300px;
    animation: float-2 10s ease-in-out infinite;
  }
  @keyframes float-1 {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-16px) rotate(3deg); }
  }
  @keyframes float-2 {
    0%, 100% { transform: translateX(0) rotate(0deg); }
    50% { transform: translateX(12px) translateY(-10px) rotate(-3deg); }
  }
  .hero__device {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 483px;
    height: auto;
  }

  /* ===== VIDEO MODAL ===== */
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .video-modal[hidden] {
    display: none;
  }
  .video-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
  }
  .video-modal__content {
    position: relative;
    width: 90%;
    max-width: 900px;
  }
  .video-modal__close {
    position: absolute;
    top: -44px;
    right: 0;
    background: none;
    border: none;
    color: var(--color-cream);
    font-size: 32px;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s ease;
    line-height: 1;
  }
  .video-modal__close:hover {
    opacity: 1;
  }
  .video-modal__player {
    width: 100%;
    border-radius: 12px;
    background: #000;
  }

  /* ===== HOW IT WORKS ===== */
  .how-it-works {
    background-color: var(--color-cream);
  }
  .how-it-works__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 64px;
  }
  .how-it-works__sub {
    margin-top: 20px;
  }

  /* --- Interactive Steps --- */
  .steps-interactive {
    display: flex;
    flex-direction: column;
    gap: 88px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .step-row {
    display: flex;
    justify-content: center;
    overflow: visible;
  }
  .step-tile {
    width: 100%;
    padding: 24px 44px;
    background-color: var(--color-dark);
    border-radius: 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    overflow: visible;
    height: 260px;
    box-sizing: border-box;
    position: relative;
  }
  .step-row--reverse .step-tile { direction: rtl; }
  .step-row--reverse .step-tile > * { direction: ltr; }
  .step-tile__text { display: flex; flex-direction: column; justify-content: center; align-self: center; }
  .step-tile__heading { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
  .step-tile__num { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background-color: var(--color-gold); color: var(--color-dark); font-family: var(--font-body); font-size: 16px; font-weight: 700; flex-shrink: 0; }
  .step-tile__title { font-family: var(--font-headline); font-size: 36px; color: var(--color-cream); line-height: 1.2; }
  .step-tile__body { font-size: 20px; line-height: 1.7; color: var(--color-text-muted); max-width: 48ch; white-space: nowrap; }
  .step-tile__visual { display: flex; justify-content: center; align-items: center; overflow: visible; position: relative; align-self: center; height: 0; }
  .step-tile::before { content: ''; position: absolute; background: var(--color-gold); z-index: 1; pointer-events: none; }
  .step-tile__text, .step-tile__visual { position: relative; z-index: 2; }
  .step-row:nth-child(1) .step-tile::before { width: 275px; height: 253px; border-radius: 62% 38% 46% 54% / 60% 44% 56% 40%; right: 16%; top: -10px; }
  .step-row:nth-child(2) .step-tile::before { width: 380px; height: 340px; border-radius: 44% 56% 35% 65% / 55% 40% 60% 45%; left: 5%; top: -50px; }
  .step-row:nth-child(3) .step-tile::before { width: 340px; height: 320px; border-radius: 55% 45% 60% 40% / 38% 62% 38% 62%; right: 15%; top: -30px; }
  .step-tile__photo { max-width: 170px; height: auto; border-radius: 24px; filter: drop-shadow(0 16px 40px rgba(0,0,0,0.3)); margin: -30px 0; position: relative; z-index: 1; }

  /* Device: MacBook */
  .device-macbook { position: relative; width: 110%; max-width: 620px; margin: -60px -5% -30px; z-index: 1; }
  .device-macbook__bezel { position: relative; width: 100%; height: auto; display: block; z-index: 2; pointer-events: none; }
