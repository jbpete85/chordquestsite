---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  slug: string;
  readingTime: number;
}

const { title, description, pubDate, category, slug, readingTime } = Astro.props;
const base = import.meta.env.BASE_URL;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<a href={`${base}blog/${slug}`} class="blog-card">
  <div class="blog-card__meta">
    <span class="blog-card__category">{category}</span>
    <span class="blog-card__dot">&middot;</span>
    <span class="blog-card__time">{readingTime} min read</span>
  </div>
  <h3 class="blog-card__title">{title}</h3>
  <p class="blog-card__desc">{description}</p>
  <div class="blog-card__footer">
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    <span class="blog-card__arrow">&rarr;</span>
  </div>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: 12px;
    padding: 32px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .blog-card:hover {
    border-color: var(--color-gold);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }
  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }
  .blog-card__category {
    color: var(--color-gold);
    font-weight: 500;
  }
  .blog-card__dot {
    color: var(--color-border-light);
  }
  .blog-card__title {
    font-family: var(--font-headline);
    font-size: 24px;
    line-height: 1.25;
    margin-bottom: 12px;
    color: var(--color-dark);
  }
  .blog-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-warm);
    flex: 1;
    margin-bottom: 20px;
  }
  .blog-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--color-text-muted);
    padding-top: 16px;
    border-top: 1px solid var(--color-border-light);
  }
  .blog-card__arrow {
    font-size: 18px;
    color: var(--color-gold);
    transition: transform 0.2s ease;
  }
  .blog-card:hover .blog-card__arrow {
    transform: translateX(4px);
  }
</style>
