---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  keywords: string[];
  readingTime: number;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  keywords,
  readingTime,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: {
    '@type': 'Organization',
    name: 'Chord Quest',
    url: 'https://chordquestmusic.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Chord Quest',
    url: 'https://chordquestmusic.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://chordquestmusic.com/images/logo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.href,
  },
  keywords: keywords.join(', '),
});
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords.join(', ')} />
  <link rel="canonical" href={canonicalURL} />
  <title>{title} — Chord Quest</title>

  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}apple-touch-icon.png`} />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL('images/og-image.png', Astro.site).href} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Chord Quest" />
  <meta property="article:published_time" content={pubDate.toISOString()} />
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('images/og-image.png', Astro.site).href} />

  <!-- Preload above-the-fold fonts (self-hosted; see src/styles/global.css) -->
  <link rel="preload" href={`${base}fonts/dm-sans-400.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}fonts/dm-serif-display-400.woff2`} as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" set:html={articleSchema} />
</head>
<body>
  <Nav />
  <main>
    <article class="blog-post">
      <header class="blog-post__header container container--narrow">
        <a href={`${base}blog`} class="blog-post__back">&larr; All Posts</a>
        <div class="blog-post__meta">
          <span class="blog-post__category">{category}</span>
          <span class="blog-post__dot">&middot;</span>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span class="blog-post__dot">&middot;</span>
          <span>{readingTime} min read</span>
        </div>
        <h1 class="blog-post__title">{title}</h1>
        <p class="blog-post__subtitle">{description}</p>
        {formattedUpdate && (
          <p class="blog-post__updated">Updated {formattedUpdate}</p>
        )}
      </header>

      <div class="blog-post__body container container--narrow">
        <slot />
      </div>

      <footer class="blog-post__cta container container--narrow">
        <div class="blog-post__cta-box">
          <h3 class="blog-post__cta-title">See what your sheet music sounds like</h3>
          <p class="blog-post__cta-desc">Snap a photo of any piece of sheet music. Chord Quest reads the notes and plays back your exact part &mdash; no more guessing how it goes.</p>
          <div class="blog-post__cta-actions">
            <a href="https://apps.apple.com/us/app/chord-quest-score-playback/id6759289490" class="btn btn--gold">Download Free</a>
            <a href={`${base}teachers`} class="btn btn--outline-dark">Learn More for Teachers</a>
          </div>
        </div>
      </footer>
    </article>
  </main>
  <Footer />
</body>
</html>

<style>
  .blog-post__header {
    padding-top: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--color-border-light);
  }
  .blog-post__back {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 32px;
    transition: color 0.2s ease;
  }
  .blog-post__back:hover {
    color: var(--color-gold);
  }
  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 20px;
  }
  .blog-post__category {
    color: var(--color-gold);
    font-weight: 500;
  }
  .blog-post__dot {
    color: var(--color-border-light);
  }
  .blog-post__title {
    font-family: var(--font-headline);
    font-size: 44px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-dark);
    margin-bottom: 16px;
  }
  .blog-post__subtitle {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-warm);
    max-width: 640px;
  }
  .blog-post__updated {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-top: 12px;
  }

  /* Article body typography */
  .blog-post__body {
    padding-top: 48px;
    padding-bottom: 64px;
  }
  .blog-post__body :global(h2) {
    font-family: var(--font-headline);
    font-size: 30px;
    line-height: 1.2;
    color: var(--color-dark);
    margin-top: 48px;
    margin-bottom: 16px;
  }
  .blog-post__body :global(h3) {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-dark);
    margin-top: 36px;
    margin-bottom: 12px;
  }
  .blog-post__body :global(p) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-text-warm);
    margin-bottom: 20px;
  }
  .blog-post__body :global(ul),
  .blog-post__body :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
    list-style: disc;
  }
  .blog-post__body :global(ol) {
    list-style: decimal;
  }
  .blog-post__body :global(li) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-text-warm);
    margin-bottom: 8px;
  }
  .blog-post__body :global(strong) {
    font-weight: 600;
    color: var(--color-dark);
  }
  .blog-post__body :global(blockquote) {
    border-left: 3px solid var(--color-gold);
    padding-left: 20px;
    margin: 32px 0;
    font-style: italic;
  }
  .blog-post__body :global(blockquote p) {
    color: var(--color-dark);
    font-size: 18px;
  }
  .blog-post__body :global(a) {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }
  .blog-post__body :global(a:hover) {
    color: var(--color-gold-light);
  }
  .blog-post__body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border-light);
    margin: 40px 0;
  }
  .blog-post__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 15px;
  }
  .blog-post__body :global(th) {
    text-align: left;
    font-weight: 600;
    padding: 12px 16px;
    border-bottom: 2px solid var(--color-border-light);
    color: var(--color-dark);
  }
  .blog-post__body :global(td) {
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-border-light);
    color: var(--color-text-warm);
  }

  /* CTA section */
  .blog-post__cta {
    padding-bottom: 96px;
  }
  .blog-post__cta-box {
    background: var(--color-dark);
    border-radius: 16px;
    padding: 48px;
    text-align: center;
  }
  .blog-post__cta-title {
    font-family: var(--font-headline);
    font-size: 28px;
    color: var(--color-cream);
    margin-bottom: 12px;
  }
  .blog-post__cta-desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0 auto 28px;
  }
  .blog-post__cta-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .blog-post__title {
      font-size: 30px;
    }
    .blog-post__body :global(h2) {
      font-size: 24px;
    }
    .blog-post__cta-box {
      padding: 32px 24px;
    }
    .blog-post__cta-title {
      font-size: 24px;
    }
  }
</style>
